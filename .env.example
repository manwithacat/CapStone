# VS Code Python environment configuration
# Copy this file to .env and customize as needed
# This file is read by VS Code to set environment variables

# Add src directory to Python path for Pylance analysis
PYTHONPATH=${PYTHONPATH}:${workspaceFolder}/src

# Kaggle credentials (for headless cloud training)
# Get your username from: https://www.kaggle.com/settings
# KAGGLE_USERNAME=your-kaggle-username
