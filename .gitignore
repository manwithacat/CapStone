# Operating Systems (Cross-Platform)
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*

# WSL2 (Windows Subsystem for Linux)
.wslconfig

# ============================================================================
# Development Tools & Caches
# ============================================================================
# Ruff (Python linter)
.ruff_cache/

# Black (Python formatter)
.black/

# MyPy (type checker)
.mypy_cache/
.dmypy.json
dmypy.json

# Claude Code
.claude/

# ============================================================================
# Project-Specific Files
# ============================================================================
# Kaggle API credentials (IMPORTANT: Never commit API keys!)
kaggle.json
.kaggle/

# Environment variables and secrets
env.py
.env
.env.local
.env.*.local
.streamlit/secrets.toml

# Temporary files
*.tmp
tmp.txt
temp/
*.log

# Setup tracking files (local development only)
PROJECT_SETUP_COMPLETE.md

# Data files - Exclude large image datasets but include metadata CSV files
# NIH Chest X-Ray images (112K images, ~42GB total)
data/raw/images*/
data/raw/*.png
data/raw/*.jpg
data/raw/*.jpeg
data/raw/*.dcm

# Expert labels (from Google Cloud)
data/raw/expert_labels/

# Processed data (large image files)
data/processed/train/
data/processed/val/
data/processed/test/
data/processed/*.npy
data/processed/*.h5
data/processed/*.hdf5

# Allow small metadata CSV files (needed for dashboard)
!data/raw/*.csv
!data/processed/*.csv
!data/processed/*.json

# ============================================================================
# Machine Learning Models & Artifacts (LARGE FILES - Do not commit!)
# ============================================================================
# Trained model files (typically 100MB - 1GB+)
models/saved_models/*.keras
models/saved_models/*.h5
models/saved_models/*.hdf5
models/saved_models/*.pb
models/saved_models/*.pt
models/saved_models/*.pth
models/saved_models/*.ckpt
models/saved_models/*.weights

# Model checkpoints during training
models/saved_models/checkpoints/
models/saved_models/logs/

# Kaggle downloaded outputs (contains 308MB model file)
outputs/kaggle_cloud_training/

# Allow model metadata and small config files
!models/saved_models/*.json
!models/saved_models/*.yaml
!models/saved_models/*.yml
!models/saved_models/*.txt
!models/saved_models/README.md

# ============================================================================
# MLflow Experiment Tracking (Local artifacts - Do not commit!)
# ============================================================================
# MLflow tracking data and artifacts
mlruns/
mlflow/mlflow.db
mlflow/.mlflow_server.pid
mlflow/artifacts/

# Allow MLflow configuration
!mlflow/README.md

# ============================================================================
# Legacy / Deprecated (kept for reference, may remove later)
# ============================================================================
# Old core dumps and debug files
core.Microsoft*
core.mongo*
core.python*

# Cloudinary (legacy from template)
cloudinary_python.txt

# ============================================================================
# Jupytext (Paired Notebooks)
# ============================================================================
# NOTE: We track BOTH .ipynb and .py files for jupytext-paired notebooks
# - .py files: Clean code for editing and version control
# - .ipynb files: Execution outputs for human readability
# Jupyter notebook checkpoints already excluded above (.ipynb_checkpoints/)
