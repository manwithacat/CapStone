# ============================================================================
# Python
# ============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions (from compiled Python modules)
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller (creates standalone executables)
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.pytest_cache/

# ============================================================================
# Virtual Environments
# ============================================================================
# Multiple naming conventions for Python virtual environments
.venv/
venv/
ENV/
env/
.env

# ============================================================================
# IDEs and Editors
# ============================================================================
# VS Code
# .vscode/  # Committed to repo for pedagogical consistency
*.code-workspace

# PyCharm
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ============================================================================
# Operating Systems (Cross-Platform)
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*

# WSL2 (Windows Subsystem for Linux)
.wslconfig

# ============================================================================
# Development Tools & Caches
# ============================================================================
# Ruff (Python linter)
.ruff_cache/

# Black (Python formatter)
.black/

# MyPy (type checker)
.mypy_cache/
.dmypy.json
dmypy.json

# Claude Code
.claude/

# ============================================================================
# Project-Specific Files
# ============================================================================
# Kaggle API credentials (IMPORTANT: Never commit API keys!)
kaggle.json
.kaggle/

# Environment variables and secrets
env.py
.env
.env.local
.env.*.local
.streamlit/secrets.toml

# Temporary files
*.tmp
tmp.txt
temp/
*.log

# Setup tracking files (local development only)
PROJECT_SETUP_COMPLETE.md

# Test parameter files in root (should be in kaggle/config/test_params/)
/test_params_*.json

# Mistaken directories from shell variable expansion errors
$(pwd)/

# Archive directories
outputs/reports/archive/

# Timestamped training output files (archive these periodically)
outputs/reports/*_2025*.csv
outputs/reports/*_2024*.csv

# Data files - Exclude large image datasets but include metadata CSV files
# NIH Chest X-Ray images (112K images, ~42GB total)
data/raw/images*/
data/raw/*.png
data/raw/*.jpg
data/raw/*.jpeg
data/raw/*.dcm

# Expert labels (from Google Cloud)
data/raw/expert_labels/

# Processed data (large image files)
data/processed/train/
data/processed/val/
data/processed/test/
data/processed/*.npy
data/processed/*.h5
data/processed/*.hdf5

# Allow small metadata CSV files (needed for dashboard)
!data/raw/*.csv
!data/processed/*.csv
!data/processed/*.json

# ============================================================================
# Machine Learning Models & Artifacts (LARGE FILES - Do not commit!)
# ============================================================================
# Trained model files (typically 100MB - 1GB+)
models/saved_models/*.keras
models/saved_models/*.h5
models/saved_models/*.hdf5
models/saved_models/*.pb
models/saved_models/*.pt
models/saved_models/*.pth
models/saved_models/*.ckpt
models/saved_models/*.weights

# Model checkpoints during training
models/saved_models/checkpoints/
models/saved_models/logs/

# Kaggle downloaded outputs (contains large model files)
outputs/kaggle_cloud_training/
models/saved_models_kaggle/*.keras

# Allow model metadata and small config files
!models/saved_models/*.json
!models/saved_models/*.yaml
!models/saved_models/*.yml
!models/saved_models/*.txt
!models/saved_models/README.md

# ============================================================================
# MLflow Experiment Tracking (Local artifacts - Do not commit!)
# ============================================================================
# MLflow tracking data and artifacts
mlruns/
mlflow/mlflow.db
mlflow/.mlflow_server.pid
mlflow/artifacts/

# Allow MLflow configuration
!mlflow/README.md

# ============================================================================
# Legacy / Deprecated (kept for reference, may remove later)
# ============================================================================
# Old core dumps and debug files
core.Microsoft*
core.mongo*
core.python*

# Cloudinary (legacy from template)
cloudinary_python.txt

# ============================================================================
# Jupytext (Paired Notebooks)
# ============================================================================
# Exclude jupytext-generated .py files to reduce clutter
# - Paired .py files stored in .jupytext/ subdirectory
# - Claude can still access them for editing
# - Only track .ipynb files (which contain outputs for human readability)
# - Jupytext auto-syncs .py ↔ .ipynb on read/write
.jupytext/
jupyter_notebooks/**/*.py

# Jupyter notebook checkpoints already excluded above (.ipynb_checkpoints/)

# Colab OAuth credentials
.colab/

# ============================================================================
# Platform-Specific Directories (New Organization)
# ============================================================================
# Kaggle results (downloaded models and outputs)
kaggle/results/*/
!kaggle/results/*/.gitkeep

# Kaggle datasets (large files)
kaggle/datasets/imagenet-weights/*.h5
kaggle/datasets/data-splits/*.csv

# Pretrained weights (large files)
models/pretrained_weights/*.h5
models/pretrained_weights/*.pb

# Colab ephemeral outputs
colab/outputs/

# Legacy directories (archived in kaggle/legacy/)
kaggle/legacy/

# nbpush activity logs (LLM-optimized, keep in repo)
# .logs/ intentionally not ignored - these logs are for Claude to track activity
