{
  "MODELS_TO_TRAIN": ["resnet50", "densenet121", "efficientnetb3"],
  "RUN_NAME": "kaggle_07_full_training",
  "USE_MLFLOW": false,
  "RETRAIN_MODELS": true,
  "CONFIG": {
    "img_height": 224,
    "img_width": 224,
    "channels": 3,
    "batch_size": 16,
    "epochs_stage1": 3,
    "learning_rate_stage1": 0.001,
    "epochs_stage2": 7,
    "learning_rate_stage2": 0.0001,
    "unfreeze_layers": 20,
    "dense_units": 512,
    "dropout_rate": 0.5,
    "early_stopping_patience": 10,
    "reduce_lr_patience": 5,
    "num_classes": 14,
    "use_sample": false,
    "random_state": 42
  }
}
